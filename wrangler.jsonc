{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fakeboot",
  "compatibility_date": "2025-09-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "fakeboot.paulromeo.net",
      "custom_domain": true
    }
  ]
}
